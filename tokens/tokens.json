{
  "$comment": "Ascent Studios design tokens — Phase 2. Mirror of tokens.css. Feeds the Tailwind theme. Edit here, not in tailwind.config.",
  "meta": {
    "brand": "Ascent Studios",
    "phase": 2,
    "supersedes": "Phase 1 visual system (brass accent, serif display, square corners, near-zero depth)",
    "legend": {
      "SPEC": "verbatim from the Phase 2 brief",
      "DERIVED": "computed from a spec value",
      "A11Y": "added to satisfy the brief's own WCAG AA requirement"
    }
  },

  "color": {
    "blue": {
      "50":  { "value": "#F0F9FF", "tag": "DERIVED", "use": "lightest wash, callout blocks" },
      "100": { "value": "#D7EEFE", "tag": "DERIVED", "use": "hover backgrounds, section transitions" },
      "200": { "value": "#B4DFFD", "tag": "DERIVED", "use": "illustration accents" },
      "300": { "value": "#7EC7FC", "tag": "DERIVED", "use": "accent on deep surfaces" },
      "400": { "value": "#3FAEFD", "tag": "DERIVED", "use": "motion layers, decorative" },
      "500": { "value": "#0597FF", "tag": "SPEC",    "use": "THE BRAND BLUE — non-text use" },
      "600": { "value": "#0685E0", "tag": "DERIVED", "use": "pressed and active fills" },
      "700": { "value": "#0870BA", "tag": "A11Y",    "use": "links, filled CTAs, focus rings — anything carrying text" },
      "800": { "value": "#095890", "tag": "DERIVED", "use": "pressed state of blue-700" },
      "900": { "value": "#09314E", "tag": "DERIVED", "use": "deep brand navy" }
    },

    "surface": {
      "bg":       { "value": "#FAFAF8", "tag": "SPEC", "use": "warm off-white. Dominates the experience." },
      "elevated": { "value": "#FFFFFF", "tag": "SPEC", "use": "cards, nav, dialogs — only when elevation is required" },
      "surface":  { "value": "#F5F7FA", "tag": "SPEC", "use": "cool panel surface" },
      "wash":     { "value": "#F0F9FF", "tag": "SPEC", "use": "occasional sky blue" }
    },

    "text": {
      "primary":   { "value": "#111111", "tag": "SPEC", "contrast": 18.1, "use": "headlines, body" },
      "secondary": { "value": "#5F6368", "tag": "SPEC", "contrast": 5.79, "use": "supporting copy" },
      "muted":     { "value": "#6B7075", "tag": "A11Y", "contrast": 4.78, "use": "captions, meta — AA at any size" },
      "muted-lg":  { "value": "#8B8B8B", "tag": "SPEC", "contrast": 3.26, "use": "LARGE TEXT ONLY — ≥24px, or ≥18.66px bold. Fails AA at caption size." },
      "on-brand":  { "value": "#FFFFFF", "tag": "SPEC" },
      "link":      { "value": "#0870BA", "tag": "A11Y", "contrast": 4.99 }
    },

    "line": {
      "border":        { "value": "#E5E7EB", "tag": "SPEC" },
      "divider":       { "value": "#ECECEC", "tag": "SPEC" },
      "border-strong": { "value": "#D3D7DE", "tag": "DERIVED", "use": "inputs, emphasis" }
    },

    "state": {
      "success": "#1E7A4B",
      "warning": "#9A6300",
      "error": "#C0392B",
      "$rule": "Never rely on colour alone. Always pair with an icon, label or shape."
    },

    "deep": {
      "$status": "PROPOSED — pending confirmation. Phase 1 chose dark anchor sections; the Phase 2 background list omits them. Kept as brand navy so the decision stays open at zero cost.",
      "bg": "#082236",
      "raised": "#0E2E45",
      "text": "#FAFAF8",
      "text-2": "#A9B6C2",
      "border": "#1B3E58",
      "accent": "#7EC7FC"
    }
  },

  "contrastAudit": {
    "$comment": "WCAG 2.1 ratios against #FAFAF8 unless noted. Re-verify before changing any colour.",
    "#111111 on bg": 18.1,
    "#5F6368 on bg": 5.79,
    "#6B7075 on bg": 4.78,
    "#8B8B8B on bg": 3.26,
    "#0597FF on bg": 2.92,
    "#0870BA on bg": 4.99,
    "white on #0597FF": 3.05,
    "white on #0870BA": 5.22,
    "#7EC7FC on #082236": 8.87,
    "$failures": [
      "#0597FF as link text on bg — 2.92:1, fails AA 4.5:1 and the 3:1 non-text minimum",
      "White text on a #0597FF filled button — 3.05:1, fails AA 4.5:1",
      "#8B8B8B at 14px caption — 3.26:1, fails AA 4.5:1"
    ],
    "$resolution": "blue-700 #0870BA carries text and focus rings; blue-500 #0597FF is reserved for non-text use. muted text is #6B7075."
  },

  "font": {
    "sans": "'Helvetica Neue', Inter, Geist, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace",
    "$note": "This stack renders Helvetica Neue on macOS and Inter elsewhere. The two differ in width and x-height, so line breaks and rhythm shift by platform. Recommendation in the design system doc: ship one self-hosted family."
  },

  "type": {
    "hero":       { "size": "clamp(2.625rem, 5.5vw, 6rem)", "px": "42 → 96", "weight": 700, "lineHeight": 1.05, "tracking": "-0.035em" },
    "section":    { "size": "clamp(2rem, 3.6vw, 4rem)",     "px": "32 → 64", "weight": 700, "lineHeight": 1.1,  "tracking": "-0.025em" },
    "subheading": { "size": "clamp(1.5rem, 2.2vw, 2.5rem)", "px": "24 → 40", "weight": 600, "lineHeight": 1.2,  "tracking": "-0.015em" },
    "body-lg":    { "size": "clamp(1.25rem, 1.4vw, 1.5rem)","px": "20 → 24", "weight": 400, "lineHeight": 1.5,  "tracking": "-0.005em" },
    "body":       { "size": "1.125rem",                     "px": "18",      "weight": 400, "lineHeight": 1.6,  "tracking": "0" },
    "small":      { "size": "1rem",                         "px": "16",      "weight": 400, "lineHeight": 1.55, "tracking": "0" },
    "caption":    { "size": "0.875rem",                     "px": "14",      "weight": 400, "lineHeight": 1.45, "tracking": "0" },
    "label":      { "size": "0.75rem",                      "px": "12",      "weight": 600, "lineHeight": 1.2,  "tracking": "0.1em", "transform": "uppercase" },
    "button":     { "weight": 600 },
    "$measure": "70ch maximum paragraph width. Break paragraphs every 2–4 lines."
  },

  "layout": {
    "content": "1280px",
    "editorial": "960px",
    "reading": "780px",
    "grid": {
      "mobile":  { "columns": 4,  "gutter": "16px", "containerPadding": "24px" },
      "tablet":  { "columns": 8,  "gutter": "24px", "containerPadding": "40px" },
      "desktop": { "columns": 12, "gutter": "32px", "containerPadding": "64px" }
    }
  },

  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1440px" },

  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "24px", "6": "32px", "7": "40px", "8": "48px",
    "9": "64px", "10": "96px", "11": "160px", "12": "220px",
    "section-y": "clamp(80px, 11vw, 160px)",
    "section-y-lg": "clamp(112px, 15vw, 220px)",
    "$spec": "Standard section 160px · large story section 220px · small components 48px · card padding 32px · internal component padding 24–40px"
  },

  "radius": {
    "button": "14px",
    "input": "14px",
    "card": "18px",
    "image": "20px",
    "floating": "24px",
    "container": "28px",
    "full": "999px",
    "$rule": "No sharp corners. No excessive rounding. 999px is for avatars and dots only — never buttons."
  },

  "shadow": {
    "xs": "0 1px 2px rgba(16,24,40,0.04)",
    "card": "0 1px 2px rgba(16,24,40,0.04), 0 4px 12px rgba(16,24,40,0.05)",
    "nav": "0 1px 0 rgba(16,24,40,0.05), 0 8px 24px rgba(16,24,40,0.06)",
    "modal": "0 24px 64px rgba(16,24,40,0.12)",
    "cta": "0 6px 20px rgba(5,151,255,0.22)",
    "$rule": "Subtle, almost invisible. Never create depth through large shadows — use spacing. Shadows are blue-black, not neutral-black, so they sit with the palette."
  },

  "motion": {
    "$scope": "Phase 3 — complete motion system. Implementation (GSAP, Framer Motion, Lenis, Three.js) is deliberately deferred.",
    "$ceiling": "Never exceed 1000ms.",

    "level": {
      "1-micro":     { "scope": "hover, buttons, cards, links, nav, icons", "purpose": "feedback",         "budget": "unlimited" },
      "2-component": { "scope": "cards, images, typography entering view",  "purpose": "guide attention",  "budget": "most sections" },
      "3-section":   { "scope": "section reveals, pinned, background shifts","purpose": "tell the story",  "budget": "a few per page" },
      "4-cinematic": { "scope": "Hero, Operating System, Transformation, Connect With Us", "purpose": "create memory", "budget": "four moments, site-wide — a fixed budget, not a guideline" }
    },

    "duration": {
      "hover": "180ms",
      "button": "180ms",
      "card": "250ms",
      "component": "350ms",
      "section": "450ms",
      "page": "500ms",
      "fade": "300ms",
      "hero": "700ms",
      "$note": "Page fade (300ms, first paint) and page transition (500ms, route change) are separate things."
    },

    "easing": {
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "inout": "cubic-bezier(0.4, 0, 0.2, 1)",
      "springMicro": { "stiffness": 380, "damping": 32, "$rule": "Level 1 only. Critically damped — visible overshoot is a bounce, and bounce is banned." }
    },

    "signatureReveal": {
      "$sequence": "opacity → translateY → blur-to-sharp",
      "$cap": "Never combine more than three transformations. This is already at the cap — nothing may be layered on top.",
      "component": { "y": "16px", "blur": "4px", "duration": "350ms" },
      "section":   { "y": "24px", "blur": "6px", "duration": "450ms" },
      "hero":      { "y": "32px", "blur": "8px", "duration": "700ms" },
      "threshold": 0.15,
      "once": true,
      "stagger": { "delay": "80ms", "maxSiblings": 6, "$math": "6 × 80ms = 480ms, inside the 1000ms ceiling" }
    },

    "interaction": {
      "liftHover": "-2px",
      "liftHoverMax": "-4px",
      "scaleCard": 1.02,
      "scaleImage": 1.03
    },

    "parallax": {
      "background": 0.05,
      "midground": 0.15,
      "foreground": 0.25,
      "maxTravel": "120px",
      "$note": "Percentages of scroll distance through the section. Applies to visual layers; typography uses the kinetic typography rules."
    },

    "pinned": {
      "maxPinLength": "2 viewport heights",
      "maxSectionsSiteWide": 2,
      "minViewport": "1024px",
      "$rules": ["legible at any scroll position including the first frame", "fast scroll reaches the end state", "never pin decorative content"]
    },

    "blurConstraint": {
      "maxConcurrent": 3,
      "maxRadius": "8px",
      "disabledBelow": "768px",
      "$why": "filter: blur() forces an offscreen render pass per element per frame — the most reliable way to drop below 60fps on mobile. It is the first thing dropped; the reveal reads correctly without it.",
      "$never": ["large images", "full-bleed backgrounds", "video", "Level 1 interactions"]
    },

    "performance": {
      "floor": "60fps on a mid-range Android phone",
      "animate": ["opacity", "transform", "filter (sparingly)"],
      "neverAnimate": ["width", "height", "top", "left", "margin"],
      "$rules": ["will-change only for the animation's duration", "IntersectionObserver over scroll listeners", "no layout shift — CLS under 0.1", "above-fold motion must not delay LCP"]
    },

    "reducedMotion": {
      "smoothScroll": "off",
      "parallax": "off",
      "pinned": "off — static stacked content",
      "blur": "off",
      "largeTransitions": "opacity only",
      "counters": "final number immediately",
      "marquee": "static",
      "microInteractions": "retained — colour and border changes are feedback, not motion"
    },

    "$forbidden": [
      "bounce", "elastic", "rotating or spinning text", "distorted typography",
      "morphing logos", "morphing navigation", "continuously animating icons",
      "spinners", "repeating counters", "dramatic zoom", "rotating images",
      "pinning decorative content", "site-wide scroll snap", "animation for its own sake"
    ]
  },

  "z": { "base": 0, "sticky": 10, "nav": 100, "modal": 200 }
}
